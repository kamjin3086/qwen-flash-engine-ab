data: {"id":"chatcmpl-f7fdd28e7d914f1c89e211e698e3daf3","object":"chat.completion.chunk","created":1792653623,"model":"kyojin-qwen38","choices":[{"index":0,"delta":{"tool_calls":[{"id":"call_21290eefe41642f6819c721e","type":"function","function":{"name":"write_file","arguments":"{\"path\": \"index.html\", \"content\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>Voxel Pagoda Garden</title>\\n<style>\\n  html, body { margin: 0; padding: 0; overflow: hidden; background: #0a0a12; }\\n  #overlay {\\n    position: fixed; top: 18px; left: 20px; z-index: 10;\\n    font-family: 'Courier New', monospace; color: #ffe9f0;\\n    text-shadow: 0 1px 4px rgba(0,0,0,.8); pointer-events: none;\\n  }\\n  #overlay h1 { margin: 0; font-size: 20px; letter-spacing: 3px; }\\n  #overlay p { margin: 4px 0 0; font-size: 11px; opacity: .75; letter-spacing: 1px; }\\n  #loading {\\n    position: fixed; inset: 0; background: #0a0a12; z-index: 20;\\n    display: flex; align-items: center; justify-content: center;\\n    font-family: 'Courier New', monospace; color: #ff9ec4; font-size: 14px;\\n    letter-spacing: 4px; transition: opacity .8s;\\n  }\\n</style>\\n</head>\\n<body>\\n<div id=\\\"loading\\\">BUILDING VOXELS…</div>\\n<div id=\\\"overlay\\\">\\n  <h1>⛩  voxel pagoda garden  ⛩</h1>\\n  <p>drag to orbit · scroll to zoom · cherry blossoms falling</p>\\n</div>\\n<script type=\\\"importmap\\\">\\n{ \\\"imports\\\": { \\\"three\\\": \\\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\\\" } }\\n</script>\\n<script type=\\\"module\\\">\\nimport * as THREE from 'three';\\n\\n// ---------- renderer / scene ----------\\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\\nrenderer.setSize(innerWidth, innerHeight);\\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\\nrenderer.shadowMap.enabled = true;\\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\\ndocument.body.appendChild(renderer.domElement);\\n\\nconst scene = new THREE.Scene();\\nscene.background = new THREE.Color(0x9fd4ee);\\nscene.fog = new THREE.Fog(0x9fd4ee, 60, 160);\\n\\nconst camera = new THREE.PerspectiveCamera(50, innerWidth/innerHeight, 0.1, 500);\\n\\n// ---------- sky gradient ----------\\n{\\n  const c = document.createElement('canvas'); c.width = 2; c.height = 256;\\n  const g = c.getContext('2d');\\n  const grad = g.createLinearGradient(0,0,0,256);\\n  grad.addColorStop(0,'#4a90d9'); grad.addColorStop(0.5,'#9fd4ee'); grad.addColorStop(1,'#ffe3ec');\\n  g.fillStyle = grad; g.fillRect(0,0,2,256);\\n  const tex = new THREE.CanvasTexture(c);\\n  scene.background = tex;\\n}\\n\\n// ---------- lights ----------\\nscene.add(new THREE.HemisphereLight(0xbfe3ff, 0x6a5a4a, 0.85));\\nconst sun = new THREE.DirectionalLight(0xfff2d8, 1.6);\\nsun.position.set(40, 60, 25);\\nsun.castShadow = true;\\nsun.shadow.mapSize.set(2048, 2048);\\nsun.shadow.camera.left = -60; sun.shadow.camera.right = 60;\\nsun.shadow.camera.top = 60; sun.shadow.camera.bottom = -60;\\nsun.shadow.camera.far = 200;\\nscene.add(sun);\\n\\n// ---------- voxel world (instanced) ----------\\nconst world = new THREE.Group();\\nscene.add(world);\\nconst voxels = []; // {x,y,z,color,sx,sy,sz}\\nfunction V(x, y, z, color, sx=1, sy=1, sz=1) {\\n  voxels.push({ x, y, z, color, sx, sy, sz });\\n}\\nfunction box(x0,y0,z0,x1,y1,z1,color,fn) {\\n  for (let x=x0;x<=x1;x++) for (let y=y0;y<=y1;y++) for (let z=z0;z<=z1;z++) {\\n    if (!fn || fn(x,y,z)) V(x,y,z,color);\\n  }\\n}\\n// deterministic rng\\nlet seed = 1234;\\nfunction rnd(){ seed = (seed*16807) % 2147483647; return (seed-1)/2147483646; }\\nfunction pick(a){ return a[Math.floor(rnd()*a.length)]; }\\n\\n// ---------- palette ----------\\nconst C = {\\n  trunk: 0x6b4a2e, trunkDark: 0x553a24,\\n  leaf: [0x3fae4a, 0x2f9e3f, 0x5cc45a, 0x79d06a],\\n  blossom: [0xffb7d2, 0xff9ec4, 0xffd3e2, 0xff86b6],\\n  stone: [0x9a9aa2, 0x8b8b93, 0xa8a8b0],\\n  stoneDark: 0x77777f,\\n  wall: 0xf2e8d5, wallTrim: 0x8a5a3a,\\n  roof: 0xb3372e, roofDark: 0x8f2a24,\\n  roofGold: 0xe8b93a,\\n  wood: 0x9a6a3f, woodDark: 0x7a4f2c,\\n  water: 0x4aa8d8, waterDeep: 0x2f7fb0,\\n  path: [0xd9c9a8, 0xcdba96, 0xe4d6b8],\\n  lantern: 0xffcf6e,\\n  koi: [0xff7733, 0xffffff, 0xff4444],\\n  grass: [0x59b95c, 0x4cae50, 0x66c466],\\n  tulip: [0xff5a7a, 0xffd23a, 0xff8a2a, 0xc86aff],\\n};\\n\\n// ---------- terrain: island ----------\\nconst R = 34; // island radius\\nconst heightAt = (x,z) => {\\n  const d = Math.hypot(x,z);\\n  let h = 0;\\n  if (d < R) {\\n    h = 3;\\n    // gentle hills at edges of pond area\\n    h += Math.max(0, Math.round(2.2*Math.sin(x*0.18)*Math.cos(z*0.16)));\\n    // pond depression\\n    const pd = Math.hypot(x-14, z+8);\\n    if (pd < 9) h = 1;\\n    // plateau for pagoda\\n    if (Math.hypot(x+8, z-4) < 11) h = 4;\\n    if (d > R-3) h = Math.max(2, h-1);\\n  }\\n  return h;\\n};\\n\\nfor (let x=-R; x<=R; x++) for (let z=-R; z<=R; z++) {\\n  const d = Math.hypot(x,z);\\n  if (d > R) continue;\\n  const h = heightAt(x,z);\\n  const pd = Math.hypot(x-14, z+8);\\n  const inPond = pd < 8;\\n  // top layer\\n  let col;\\n  if (inPond) col = C.stoneDark;\\n  else if (d > R-2.5) col = 0xc9b98a; // sandy rim\\n  else col = pick(C.grass);\\n  V(x, h, z, col);\\n  // fill below\\n  for (let y=h-1; y>=h-3 && y>=0; y--) {\\n    V(x, y, z, y===0 ? 0x6a5a48 : (inPond && y===h-1 ? C.waterDeep : 0x7a5c3e));\\n  }\\n}\\n// water surface\\nfor (let x=-R; x<=R; x++) for (let z=-R; z<=R; z++) {\\n  if (Math.hypot(x-14, z+8) < 8 && Math.hypot(x,z) <= R) V(x, 2, z, C.water);\\n}\\n\\n// ---------- pagoda ----------\\nfunction pagoda(ox, oz, baseY) {\\n  // stone platform\\n  box(ox-8, baseY+1, oz-8, ox+8, baseY+1, oz+8, C.stone);\\n  box(ox-7, baseY+2, oz-7, ox+7, baseY+2, oz+7, C.stoneDark);\\n  // steps\\n  for (let s=0;s<3;s++) box(ox-2, baseY+1+s, oz+9+s*0|0, ox+2, baseY+1+s, oz+9+s, C.stone);\\n\\n  const floors = 5;\\n  let y = baseY + 3;\\n  for (let f=0; f<floors; f++) {\\n    const w = 6 - f;           // half-width of body\\n    const hBody = 3;\\n    // walls\\n    box(ox-w, y, oz-w, ox+w, y+hBody-1, oz+w, C.wall,\\n      (x,yy,z)=> (x===ox-w||x===ox+w||z===oz-w||z===oz+w));\\n    // corner pillars\\n    for (const dx of [-w,w]) for (const dz of [-w,w])\\n      for (let yy=0; yy<hBody; yy++) V(ox+dx, y+yy, oz+dz, C.woodDark);\\n    // windows / door\\n    if (f===0) {\\n      for (let dx=-1;dx<=1;dx++) for (let dy=0;dy<2;dy++) V(ox+dx, y+dy, oz+w, C.woodDark);\\n    } else {\\n      V(ox, y+1, oz+w, C.roofDark); V(ox, y+1, oz-w, C.roofDark);\\n      V(ox-w, y+1, oz, C.roofDark); V(ox+w, y+1, oz, C.roofDark);\\n    }\\n    // trim band\\n    box(ox-w-1, y+hBody, oz-w-1, ox+w+1, y+hBody, oz+w+1, C.wallTrim);\\n    // roof — layered pyramid with upturned corners\\n    const rw = w + 3;\\n    const ry = y + hBody + 1;\\n    for (let l=0; l<3; l++) {\\n      const s = rw - l;\\n      box(ox-s, ry+l, oz-s, ox+s, ry+l, oz+s, l===2 ? C.roofDark : C.roof,\\n        (x,yy,z)=>{\\n          const ex = Math.abs(x-ox)===s, ez = Math.abs(z-oz)===s;\\n          return ex || ez || s<=2;\\n        });\\n      // upturned corner tips on lowest roof layer\\n      if (l===0) for (const dx of [-s,s]) for (const dz of [-s,s]) {\\n        V(ox+dx, ry+1, oz+dz, C.roofGold);\\n      }\\n    }\\n    // ridge ornaments\\n    V(ox, ry+3, oz, C.roofGold);\\n    y = ry + 3;\\n  }\\n  // spire\\n  for (let s=0; s<6; s++) V(ox, y+s, oz, s%2? C.roofGold : C.woodDark);\\n  V(ox, y+6, oz, 0xffe27a);\\n  // bells at corners of top roof\\n  for (const dx of [-1,1]) for (const dz of [-1,1]) V(ox+dx*7, y-1, oz+dz*7, C.roofGold);\\n}\\npagoda(-8, -4, heightAt(-8,-4));\\n\\n// ---------- torii gate ----------\\nfunction torii(ox, oz, baseY) {\\n  const y0 = baseY+1;\\n  for (let yy=0; yy<8; yy++) { V(ox-3,y0+yy,oz,C.woodDark); V(ox+3,y0+yy,oz,C.woodDark); }\\n  box(ox-4, y0+8, oz, ox+4, y0+8, oz, C.roof);\\n  box(ox-5, y0+9, oz, ox+5, y0+9, oz, C.roof);\\n  box(ox-6, y0+10, oz-1, ox+6, y0+10, oz+1, C.roofDark);\\n  V(ox-6,y0+11,oz-1,C.roofGold); V(ox+6,y0+11,oz+1,C.roofGold);\\n  box(ox-3, y0+6, oz, ox+3, y0+6, oz, C.woodDark);\\n}\\ntorii(-8, 10, heightAt(-8,10));\\ntorii(-8, 16, heightAt(-8,16));\\n\\n// ---------- stone path ----------\\n{\\n  let px=-8, pz=22;\\n  for (let i=0;i<40;i++) {\\n    const h = heightAt(Math.round(px), Math.round(pz));\\n    if (Math.hypot(px,pz) < R-1) V(Math.round(px), h+1, Math.round(pz), pick(C.path));\\n    // wind toward pagoda then around\\n    const t = i/40;\\n    px += Math.sin(t*7)*0.9 - 0.15;\\n    pz -= 0.75 + Math.cos(t*4)*0.3;\\n    if (Math.hypot(px+8,pz+4) < 10) { px += (px<-8?-1:1)*1.2; }\\n  }\\n}\\n\\n// ---------- trees ----------\\nfunction tree(x, z, blossom=false, big=false) {\\n  const h = heightAt(x,z);\\n  if (h < 2 || Math.hypot(x-14,z+8) < 9) return;\\n  const th = big ? 6+Math.floor(rnd()*3) : 4+Math.floor(rnd()*3);\\n  const cols = blossom ? C.blossom : C.leaf;\\n  for (let yy=1; yy<=th; yy++) V(x, h+yy, z, yy%2? C.trunk : C.trunkDark);\\n  const r = big ? 3 : 2;\\n  for (let dx=-r; dx<=r; dx++) for (let dy=-r; dy<=r; dy++) for (let dz=-r; dz<=r; dz++) {\\n    const d = Math.hypot(dx, dy*1.25, dz);\\n    if (d <= r + rnd()*0.6 - 0.2) {\\n      const yy = h + th + 1 + dy;\\n      if (yy > h && !(dy<0 && Math.abs(dx)<1 && Math.abs(dz)<1))\\n        V(x+dx, yy, z+dz, pick(cols));\\n    }\\n  }\\n  // drooping branches for blossoms\\n  if (blossom) for (let k=0;k<5;k++){\\n    const a = rnd()*Math.PI*2, rr = r;\\n    let bx = x+Math.round(Math.cos(a)*rr), bz = z+Math.round(Math.sin(a)*rr);\\n    for (let d=1; d<=2+Math.floor(rnd()*2); d++)\\n      V(bx, h+th+2-d, bz, pick(cols));\\n  }\\n}\\nconst treeSpots = [\\n  [-22,-14,1,1],[-26,2,1,0],[-18,18,1,1],[6,20,1,1],[20,14,1,0],\\n  [26,-2,0,1],[-28,-4,0,0],[10,-22,0,0],[-12,-24,1,0],[24,8,1,0],\\n  [-20,8,0,0],[2,-26,1,1],[16,22,0,0],[-26,14,0,1],[28,-12,0,0],\\n  [-4,-28,0,1],[12,4,0,0],[22,-20,1,0],[-30,-10,1,0],[6,12,0,0],\\n];\\nfor (const [x,z,b,big] of treeSpots) tree(x,z,b,big);\\n\\n// ---------- lanterns ----------\\nfunction lantern(x,z){\\n  const h = heightAt(x,z); if (h<2) return;\\n  V(x,h+1,z,C.stoneDark); V(x,h+2,z,C.stone);\\n  V(x,h+3,z,C.lantern);\\n  V(x,h+4,z,C.roofDark);\\n}\\nlantern(-12,12); lantern(-4,12); lantern(-16,-2); lantern(4,-6);\\nlantern(18,-16); lantern(-22,20);\\n\\n// ---------- bridge over pond edge ----------\\n{\\n  const bx0=8, bz0=-2;\\n  for (let i=0;i<10;i++){\\n    const yy = 3 + Math.round(Math.sin(i/9*Math.PI)*2);\\n    V(bx0+i, yy, bz0, C.wood); V(bx0+i, yy, bz0+1, C.wood);\\n    if (i%2===0){ V(bx0+i, yy+1, bz0-1, C.woodDark); V(bx0+i, yy+1, bz0+2, C.woodDark); }\\n  }\\n}\\n\\n// ---------- flowers & rocks scattered ----------\\nfor (let i=0;i<220;i++){\\n  const a = rnd()*Math.PI*2, r = 4 + rnd()*(R-6);\\n  const x = Math.round(Math.cos(a)*r), z = Math.round(Math.sin(a)*r);\\n  if (Math.hypot(x-14,z+8) < 9) continue;\\n  const h = heightAt(x,z);\\n  if (h<2 || Math.hypot(x,z)>R-2) continue;\\n  if (rnd()<0.7) V(x,h+1,z,pick(C.tulip));\\n  else V(x,h+1,z,pick(C.stone));\\n}\\n// rock clusters\\nfor (const [rx,rz] of [[6,10],[-16,14],[20,-18],[-24,-18]]) {\\n  const h = heightAt(rx,rz);\\n  V(rx,h+1,rz,C.stoneDark); V(rx+1,h+1,rz,pick(C.stone)); V(rx,h+1,rz+1,pick(C.stone));\\n  V(rx,h+2,rz,pick(C.stone));\\n}\\n\\n// ---------- build instanced meshes (grouped by size) ----------\\nconst geo = new THREE.BoxGeometry(1,1,1);\\nconst byColor = new Map();\\nfor (const v of voxels) {\\n  const key = v.color + '|' + v.sx + '|' + v.sy + '|' + v.sz;\\n  if (!byColor.has(key)) byColor.set(key, []);\\n  byColor.get(key).push(v);\\n}\\nfor (const [key, list] of byColor) {\\n  const [color, sx, sy, sz] = key.split('|');\\n  const mat = new THREE.MeshLambertMaterial({ color: +color });\\n  if (+color === C.water) { mat.transparent = true; mat.opacity = 0.8; }\\n  const im = new THREE.InstancedMesh(geo, mat, list.length);\\n  im.castShadow = true; im.receiveShadow = true;\\n  const m = new THREE.Matrix4();\\n  list.forEach((v,i)=>{\\n    m.makeScale(+sx,+sy,+sz);\\n    m.setPosition(v.x, v.y, v.z);\\n    im.setMatrixAt(i, m);\\n  });\\n  world.add(im);\\n}\\n\\n// ---------- falling petals ----------\\nconst petalGeo = new THREE.BoxGeometry(0.35,0.08,0.35);\\nconst petalMats = C.blossom.map(c=>new THREE.MeshLambertMaterial({color:c}));\\nconst petals = [];\\nfor (let i=0;i<160;i++){\\n  const p = new THREE.Mesh(petalGeo, petalMats[i%4]);\\n  p.position.set((rnd()-0.5)*70, rnd()*30+8, (rnd()-0.5)*70);\\n  p.userData = { sp: 0.6+rnd()*1.2, sw: rnd()*Math.PI*2, rot: (rnd()-0.5)*0.1 };\\n  scene.add(p); petals.push(p);\\n}\\n\\n// ---------- koi fish in pond ----------\\nconst koi = [];\\nfor (let i=0;i<6;i++){\\n  const g = new THREE.Group();\\n  const body = new THREE.Mesh(new THREE.BoxGeometry(0.9,0.35,0.45),\\n    new THREE.MeshLambertMaterial({color: C.koi[i%3]}));\\n  const tail = new THREE.Mesh(new THREE.BoxGeometry(0.3,0.2,0.25),\\n    new THREE.MeshLambertMaterial({color: 0xffffff}));\\n  tail.position.x = -0.6; g.add(body, tail);\\n  g.userData = { a: rnd()*Math.PI*2, r: 2+rnd()*4, sp: 0.3+rnd()*0.5 };\\n  scene.add(g); koi.push(g);\\n}\\n\\n// ---------- birds ----------\\nconst birds = [];\\nfor (let i=0;i<5;i++){\\n  const b = new THREE.Mesh(new THREE.BoxGeometry(0.6,0.15,0.15),\\n    new THREE.MeshLambertMaterial({color:0x333340}));\\n  b.userData = { a: rnd()*Math.PI*2, r: 20+rnd()*15, h: 26+rnd()*8, sp: 0.2+rnd()*0.2 };\\n  scene.add(b); birds.push(b);\\n}\\n\\n// ---------- camera orbit controls (minimal) ----------\\nlet theta = 0.7, phi = 1.12, dist = 62, target = new THREE.Vector3(0,8,0);\\nlet dragging = false, px0=0, py0=0;\\naddEventListener('pointerdown', e=>{dragging=true;px0=e.clientX;py0=e.clientY;});\\naddEventListener('pointerup', ()=>dragging=false);\\naddEventListener('pointermove', e=>{\\n  if(!dragging) return;\\n  theta -= (e.clientX-px0)*0.006;\\n  phi = Math.max(0.35, Math.min(1.45, phi - (e.clientY-py0)*0.005));\\n  px0=e.clientX; py0=e.clientY;\\n});\\naddEventListener('wheel', e=>{ dist = Math.max(25, Math.min(120, dist + e.deltaY*0.05)); });\\n\\n// ---------- animate ----------\\nconst clock = new THREE.Clock();\\nlet auto = true;\\naddEventListener('pointerdown', ()=>auto=false);\\nfunction animate(){\\n  requestAnimationFrame(animate);\\n  const t = clock.getElapsedTime(), dt = Math.min(clock.getDelta()+0.016, 0.05);\\n  if (auto) theta += 0.0012;\\n  camera.position.set(\\n    target.x + dist*Math.sin(phi)*Math.cos(theta),\\n    target.y + dist*Math.cos(phi),\\n    target.z + dist*Math.sin(phi)*Math.sin(theta));\\n  camera.lookAt(target);\\n  // petals\\n  for (const p of petals){\\n    p.position.y -= p.userData.sp * 0.028;\\n    p.userData.sw += 0.03;\\n    p.position.x += Math.sin(p.userData.sw)*0.02;\\n    p.rotation.x += p.userData.rot; p.rotation.z += p.userData.rot*0.7;\\n    if (p.position.y < 3){ p.position.y = 28+rnd()*8; p.position.x=(rnd()-0.5)*70; p.position.z=(rnd()-0.5)*70; }\\n  }\\n  // koi\\n  for (const k of koi){\\n    k.userData.a += k.userData.sp*0.01;\\n    const a = k.userData.a, r = k.userData.r;\\n    k.position.set(14+Math.cos(a)*r, 2.15, -8+Math.sin(a)*r);\\n    k.rotation.y = -a + Math.PI/2;\\n  }\\n  // birds\\n  for (const b of birds){\\n    b.userData.a += b.userData.sp*0.008;\\n    const a=b.userData.a;\\n    b.position.set(Math.cos(a)*b.userData.r, b.userData.h+Math.sin(a*3)*0.8, Math.sin(a)*b.userData.r);\\n    b.rotation.y = -a;\\n  }\\n  renderer.render(scene, camera);\\n}\\nanimate();\\n\\naddEventListener('resize', ()=>{\\n  camera.aspect = innerWidth/innerHeight;\\n  camera.updateProjectionMatrix();\\n  renderer.setSize(innerWidth, innerHeight);\\n});\\n\\n// hide loader\\nconst l = document.getElementById('loading');\\nl.style.opacity = 0; setTimeout(()=>l.remove(), 900);\\n</script>\\n</body>\\n</html>\\n\"}"},"index":0}]},"finish_reason":null}]}

